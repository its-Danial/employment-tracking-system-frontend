{
  "$schema": "https://json.schemastore.org/prettierrc",
  "trailingComma": "es5",
  "semi": false,
  "singleQuote": true,
  "useTabs": false,
  "quoteProps": "consistent",
  "bracketSpacing": true,
  "arrowParens": "always",
  "printWidth": 100,
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": ["^@(.*)$", "^#(.*)$", "^[./]"],
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true,
  "importOrderParserPlugins": ["typescript", "decorators-legacy"],
  "tailwindStylesheet": "./src/styles/main.css",
  "tailwindAttributes": [
    "content-class",
    "input-class",
    "pt:mask:class",
    "pt:root:class",
    "pt:header:class",
    "pt:content:class",
    "pt:footer:class",
    "pt:label:class",
    "pt:input:class",
    "pt:button:class",
    "pt:icon:class",
    "pt:overlay:class",
    "pt:panel:class",
    "pt:item:class",
    "pt:text:class",
    "pt:wrapper:class",
    "pt:container:class"
  ],
  "tailwindFunctions": ["cn"]
}
